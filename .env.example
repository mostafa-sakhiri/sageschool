SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# App (Vite) — local dev values live in .env.local (see `npx supabase status -o env`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Assistant (server only): OpenAI API key for the CopilotKit runtime. Without it the assistant shows as unavailable.
OPENAI_API_KEY=
# Optional: another model, "provider/model" (default openai/gpt-5-mini)
# ASSISTANT_MODEL=openai/gpt-5
